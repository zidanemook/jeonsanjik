rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/allowedUsers/$(uid));
    }
    // The owner is the account whose own allowedUsers document already carries role: 'owner',
    // written when the allowlist was first provisioned through the console. Accounts approved
    // from inside the app get only { at, email }, so they can never be owners. No UID is written
    // into these rules or into the client.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.uid)).data.get('role', '') == 'owner';
    }
    function validDetail(d) {
      return d is map
        && d.keys().hasAll(['schema','presentation','assisted','exerciseId','conceptId','title','subject','question','options','submittedAnswer','correctAnswer','explanation'])
        && d.keys().hasOnly(['schema','presentation','assisted','exerciseId','conceptId','title','subject','question','options','submittedAnswer','correctAnswer','explanation'])
        && d.schema == 1 && d.presentation in ['choice','text'] && d.assisted is bool
        && d.exerciseId is string && d.exerciseId.matches('^[A-Za-z0-9_-]{1,160}$')
        && d.conceptId is string && d.conceptId.matches('^[A-Za-z0-9_-]{1,160}$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 80
        && d.question is string && d.question.size() > 0 && d.question.size() <= 6000
        && d.options is string && d.options.size() <= 6000
        && d.submittedAnswer is string && d.submittedAnswer.size() > 0 && d.submittedAnswer.size() <= 2000
        && d.correctAnswer is string && d.correctAnswer.size() > 0 && d.correctAnswer.size() <= 2000
        && d.explanation is string && d.explanation.size() > 0 && d.explanation.size() <= 8000;
    }
    // The first allowedUsers/{owner UID} document is provisioned through the admin console and
    // carries `admin: true`. After that the owner approves accounts from inside the app; no one
    // else can grant themselves access, and no one but the owner may enumerate the collection.
    match /allowedUsers/{uid} {
      function validAllowed(d) {
        return d.keys().hasAll(['at'])
          && d.keys().hasOnly(['at','email'])
          && d.at is int && d.at > 0 && d.at <= request.time.toMillis() + 300000
          && (!('email' in d) || (d.email is string && d.email.size() <= 320));
      }
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isAdmin();
      // The owner's own document stays console-managed, so an approval flow can never drop the
      // `admin` flag or delete the grant it depends on: the owner cannot lock themselves out.
      allow create, update: if isAdmin() && uid != request.auth.uid
        && validAllowed(request.resource.data);
      allow delete: if isAdmin() && uid != request.auth.uid;
    }
    // A signed-in account that is not on the allowlist may file one request for approval, carrying
    // only the identity it already signed in with. A refusal is recorded on the same document
    // (`rejectedAt`) instead of erasing it, so the requester may ask again and the owner can still
    // tell a repeat ask from a first one.
    match /accessRequests/{uid} {
      function bounded(v) {
        return v is int && v > 0 && v <= request.time.toMillis() + 300000;
      }
      function validRequest(d) {
        return d.keys().hasAll(['uid','email','displayName','at'])
          && d.keys().hasOnly(['uid','email','displayName','at','rejectedAt'])
          && d.uid == uid && uid.matches('^[A-Za-z0-9_-]{1,160}$')
          && d.email is string && d.email.size() > 0 && d.email.size() <= 320
          && d.displayName is string && d.displayName.size() <= 160
          && bounded(d.at)
          && (!('rejectedAt' in d) || bounded(d.rejectedAt));
      }
      function mine() {
        return request.auth != null && request.auth.uid == uid;
      }
      function changed(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // A refusal is never self-inflicted: the requester cannot file one on themselves.
      allow create: if mine() && validRequest(request.resource.data)
        && !('rejectedAt' in request.resource.data);
      // Asking again only moves `at` forward. The identity is frozen once filed, and `rejectedAt`
      // is untouchable by the requester, so a refusal cannot be cleared from the requester side.
      allow update: if mine() && validRequest(request.resource.data)
        && changed(['at']) && request.resource.data.at > resource.data.at;
      // Refusing only records the decision; it may not rewrite the request it is answering.
      allow update: if isAdmin() && validRequest(request.resource.data)
        && changed(['rejectedAt']) && bounded(request.resource.data.rejectedAt);
      allow delete: if isAdmin();
    }
    match /users/{uid}/events/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['id','cardId','date','at','result','mode','detail'])
        && request.resource.data.keys().hasAll(['id','cardId','date','at','result','mode'])
        && request.resource.data.id == id
        && id.matches('^[A-Za-z0-9_-]{1,160}$')
        && request.resource.data.cardId is string
        && request.resource.data.cardId.matches('^[A-Za-z0-9_-]{1,160}$')
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.at is string && request.resource.data.at.size() <= 32
        && request.resource.data.result in ['correct','wrong','unsure']
        && request.resource.data.mode in ['quiz','legacy']
        && (!('detail' in request.resource.data) || validDetail(request.resource.data.detail));
      // Retrying an acknowledged event is harmless; changing/deleting it is denied.
      allow update: if owner(uid) && request.resource.data == resource.data;
      allow delete: if false;
    }
    match /users/{uid}/explanationViews/{id} {
      function validView(d) {
        return d.keys().hasAll(['id','openedAt']) && d.keys().hasOnly(['id','openedAt'])
          && d.id == id && id.matches('^[A-Za-z0-9_-]{1,160}$')
          && d.openedAt is int && d.openedAt >= 0
          && d.openedAt <= request.time.toMillis() + 300000
          && get(/databases/$(database)/documents/users/$(uid)/events/$(id)).data.mode == 'quiz';
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validView(request.resource.data);
      // Concurrent offline opens converge on the earlier first-open timestamp.
      allow update: if owner(uid) && validView(request.resource.data)
        && request.resource.data.openedAt <= resource.data.openedAt;
      allow delete: if false;
    }
    // One shared study position per owner: scope and the open question.
    match /users/{uid}/state/{id} {
      function optionalId(v) {
        return v == null || (v is string && v.matches('^[A-Za-z0-9_-]{1,160}$'));
      }
      function validSession(d) {
        return d.keys().hasAll(['at','subject','topic','round','cardId','exerciseId','variantIndex','type','choices'])
          && d.keys().hasOnly(['at','subject','topic','round','cardId','exerciseId','variantIndex','type','choices'])
          && d.at is int && d.at > 0
          && d.subject is string && d.subject.size() <= 80
          && d.topic is string && d.topic.size() <= 80
          && d.round is string && d.round.size() <= 80
          && optionalId(d.cardId) && optionalId(d.exerciseId)
          && (d.variantIndex == null || (d.variantIndex is int && d.variantIndex >= 0 && d.variantIndex <= 99))
          && (d.type == null || d.type in ['choice','text'])
          && (d.choices == null || (d.choices is list && d.choices.size() > 0 && d.choices.size() <= 10));
      }
      allow read: if owner(uid) && id == 'session';
      allow create: if owner(uid) && id == 'session' && validSession(request.resource.data);
      // Only a newer position may replace the stored one.
      allow update: if owner(uid) && id == 'session' && validSession(request.resource.data)
        && request.resource.data.at > resource.data.at;
      allow delete: if false;
    }
  }
}
